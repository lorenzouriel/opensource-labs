# cp .env.example .env  &&  edit
# Must match object-storage/.env — the lakehouse only reads these rustfs
# credentials, it doesn't create the rustfs container.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=Ch4nge_This_N0w!

# S3 bucket (on rustfs) used as the Iceberg warehouse root
ICEBERG_WAREHOUSE_BUCKET=warehouse

# Image tags. Pin to specific releases once the lab stabilizes.
ICEBERG_REST_VERSION=latest
TRINO_VERSION=latest

# Ports on the host
ICEBERG_REST_PORT=8181
TRINO_PORT=8080
