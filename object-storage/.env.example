# cp .env.example .env  &&  edit
# Console + S3 API credentials for rustfs.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=Ch4nge_This_N0w!

# Image tag. Pin to a specific release (e.g. 1.0.0-rc.6) 
RUSTFS_VERSION=latest

# Ports on the host
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Container memory cap (cgroup limit, not a RustFS setting)
RUSTFS_MEM_LIMIT=2g

RUSTFS_LOG_LEVEL=info
TZ=America/Sao_Paulo

# The 4 erasure-coded data paths below all live on named volumes backed by
# one physical disk, which RustFS's startup check rejects by default
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true
